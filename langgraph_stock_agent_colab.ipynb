### How to run

1) Run the install cell.
2) Set `OPENAI_API_KEY` in the environment (optional) for LLM-augmented summaries.
3) Run all cells, then execute:
```python
await run_agent('AAPL')
```
In Colab: make the last cell a separate code cell and add `await run_agent('AAPL')`.
import nest_asyncio, asyncio
nest_asyncio.apply()

app = build_graph()

async def run_agent(ticker: str):
	initial_state: AgentState = { 'User_Input': { 'ticker': ticker } }
	final_state: AgentState = await app.ainvoke(initial_state)
	print(final_state.get('User_View', 'No report generated'))
	return final_state

# Demo run: change the ticker symbol as needed, e.g., 'AAPL', 'MSFT', 'TSLA'
# await run_agent('AAPL')
def aggregate_sentiment(values: List[float]) -> Dict[str, Any]:
	if not values:
		return {'mean': 0.0, 'min': 0.0, 'max': 0.0, 'n': 0}
	return {
		'mean': float(sum(values) / len(values)),
		'min': float(min(values)),
		'max': float(max(values)),
		'n': len(values),
	}

async def node_3_summarize(state: AgentState) -> AgentState:
	news = state.get('News_Data', [])
	social = state.get('Social_Data', [])
	stock = state.get('Stock_Data', {})

	news_sent_scores = [n.get('sentiment', 0.0) for n in news]
	social_sent_scores = [s.get('sentiment', 0.0) for s in social]
	combined_scores = news_sent_scores + social_sent_scores
	combined = aggregate_sentiment(combined_scores)

	# Basic summary
	top_news = sorted(news, key=lambda n: abs(n.get('sentiment', 0.0)), reverse=True)[:5]
	current_price = None
	try:
		intraday = pd.DataFrame(stock.get('intraday', []))
		if not intraday.empty and 'Close' in intraday.columns:
			current_price = float(intraday['Close'].iloc[-1])
	except Exception:
		pass

	plain_summary = {
		'current_sentiment_mean': combined['mean'],
		'top_news': top_news,
		'current_price': current_price,
	}

	# Optional LLM-augmented summary
	if has_openai:
		llm = ChatOpenAI(model='gpt-4o-mini', temperature=0.3)
		prompt = (
			"You are a financial analyst. Summarize the stock context given JSON data: "
			"- Provide a concise overview, current sentiment, noteworthy news (max 5). "
			"- Avoid speculation, be factual."
		)
		try:
			resp = await llm.ainvoke(
				[
					{"role": "system", "content": prompt},
					{"role": "user", "content": json.dumps({'news': news[:10], 'social_n': len(social), 'price': current_price})},
				]
			)
			llm_summary_text = resp.content
		except Exception:
			llm_summary_text = None
	else:
		llm_summary_text = None

	state['Summarization_Data'] = {
		'plain_summary': plain_summary,
		'llm_summary': llm_summary_text,
	}
	state['Sentiment_Data'] = {
		'news': aggregate_sentiment(news_sent_scores),
		'social': aggregate_sentiment(social_sent_scores),
		'combined': combined,
	}
	return state


def predict_intraday_bounds(intraday_df: pd.DataFrame) -> Dict[str, Any]:
	# Simple heuristic: use last day OHLC and volatility proxy
	if intraday_df.empty or 'High' not in intraday_df.columns or 'Low' not in intraday_df.columns or 'Close' not in intraday_df.columns:
		return {'first_half': {'low': None, 'high': None}, 'second_half': {'low': None, 'high': None}}
	close = intraday_df['Close'].iloc[-1]
	high = intraday_df['High'].tail(12).max()  # ~ first half of the day if 5m bars
	low = intraday_df['Low'].tail(12).min()
	# Use recent range as a proxy and scale
	range_recent = float(high - low) if pd.notna(high) and pd.notna(low) else 0.0
	scale = 0.5  # conservative
	first_half = {'low': float(max(0.0, close - scale * range_recent)), 'high': float(close + scale * range_recent)}
	second_half = {'low': float(max(0.0, close - 0.8 * range_recent)), 'high': float(close + 0.8 * range_recent)}
	return {'first_half': first_half, 'second_half': second_half}

async def node_4_predict(state: AgentState) -> AgentState:
	stock = state.get('Stock_Data', {})
	intraday = pd.DataFrame(stock.get('intraday', []))
	prediction = predict_intraday_bounds(intraday)
	state['Prediction_Data'] = prediction
	return state


def format_report(state: AgentState) -> str:
	user = state.get('User_Input', {})
	ticker = user.get('ticker') or user.get('symbol')
	stock = state.get('Stock_Data', {})
	summary = state.get('Summarization_Data', {})
	sent = state.get('Sentiment_Data', {})
	pred = state.get('Prediction_Data', {})

	info = stock.get('info', {})
	price = summary.get('plain_summary', {}).get('current_price')
	vol = info.get('volume') or info.get('regularMarketVolume')
	yday_low = info.get('dayLow') or info.get('regularMarketDayLow')
	yday_high = info.get('dayHigh') or info.get('regularMarketDayHigh')

	report_lines = []
	report_lines.append(f"Stock: {ticker}")
	report_lines.append("")
	report_lines.append("Summary:")
	llm_summary = summary.get('llm_summary')
	if llm_summary:
		report_lines.append(llm_summary)
	else:
		report_lines.append(json.dumps(summary.get('plain_summary', {}), indent=2))
	report_lines.append("")
	report_lines.append("Top News:")
	for n in (summary.get('plain_summary', {}).get('top_news') or [])[:5]:
		report_lines.append(f"- {n.get('title')} (sent: {n.get('sentiment'):+.2f})")
		report_lines.append(f"  {n.get('link')}")
	report_lines.append("")
	report_lines.append(f"Current Price: {price}")
	report_lines.append(f"Yesterday Low/High: {yday_low} / {yday_high}")
	report_lines.append(f"Volume: {vol}")
	report_lines.append("")
	report_lines.append("Sentiment (mean):")
	report_lines.append(f"- News: {sent.get('news',{}).get('mean'):+.3f}")
	report_lines.append(f"- Social: {sent.get('social',{}).get('mean'):+.3f}")
	report_lines.append(f"- Combined: {sent.get('combined',{}).get('mean'):+.3f}")
	report_lines.append("")
	report_lines.append("Predicted Intraday Bounds:")
	report_lines.append(f"- First Half Low/High: {pred.get('first_half',{}).get('low')} / {pred.get('first_half',{}).get('high')}")
	report_lines.append(f"- Second Half Low/High: {pred.get('second_half',{}).get('low')} / {pred.get('second_half',{}).get('high')}")

	return "\n".join(report_lines)

async def node_5_report(state: AgentState) -> AgentState:
	state['User_View'] = format_report(state)
	return state


def build_graph():
	graph = StateGraph(AgentState)
	graph.add_node('node_1', node_1_user_input)
	graph.add_node('node_2', node_2_fetch_data)
	graph.add_node('node_3', node_3_summarize)
	graph.add_node('node_4', node_4_predict)
	graph.add_node('node_5', node_5_report)

	graph.set_entry_point('node_1')
	graph.add_edge('node_1', 'node_2')
	graph.add_edge('node_2', 'node_3')
	graph.add_edge('node_3', 'node_4')
	graph.add_edge('node_4', 'node_5')
	graph.add_edge('node_5', END)
	return graph.compile()
from typing import TypedDict
from langgraph.graph import StateGraph, END

class AgentState(TypedDict, total=False):
	User_Input: Dict[str, Any]
	Stock_Data: Dict[str, Any]
	News_Data: List[Dict[str, Any]]
	Social_Data: List[Dict[str, Any]]
	Summarization_Data: Dict[str, Any]
	Sentiment_Data: Dict[str, Any]
	Prediction_Data: Dict[str, Any]
	User_View: str


async def node_1_user_input(state: AgentState) -> AgentState:
	# Pass-through; expects state['User_Input'] to be set before graph run
	return state


async def node_2_fetch_data(state: AgentState) -> AgentState:
	user = state.get('User_Input', {})
	ticker = user.get('ticker') or user.get('symbol')
	if not ticker:
		raise ValueError('User_Input must include ticker or symbol')

	async def fetch_stock():
		return fetch_stock_data(ticker)

	async def fetch_news():
		return fetch_news_data(ticker)

	async def fetch_social():
		return fetch_social_data(ticker)

	stock_data, news_items, social_items = await asyncio.gather(
		fetch_stock(), fetch_news(), fetch_social()
	)

	state['Stock_Data'] = {
		'info': stock_data.info,
		'intraday': stock_data.intraday.tail(50).reset_index().to_dict(orient='records'),
		'history': stock_data.history.tail(100).reset_index().to_dict(orient='records'),
	}
	state['News_Data'] = [
		{
			'title': n.title,
			'link': n.link,
			'published': n.published,
			'summary': n.summary,
			'sentiment': n.sentiment,
		}
		for n in news_items
	]
	state['Social_Data'] = [
		{
			'text': s.text,
			'created_at': s.created_at,
			'author': s.author,
			'likes': s.likes,
			'replies': s.replies,
			'retweets': s.retweets,
			'sentiment': s.sentiment,
		}
		for s in social_items
	]
	return state
sia = SentimentIntensityAnalyzer()

@dataclass
class StockData:
	info: Dict[str, Any]
	intraday: pd.DataFrame
	history: pd.DataFrame

@dataclass
class NewsItem:
	title: str
	link: str
	published: Optional[str]
	summary: Optional[str]
	sentiment: float

@dataclass
class SocialItem:
	text: str
	created_at: Optional[str]
	author: Optional[str]
	likes: Optional[int]
	replies: Optional[int]
	retweets: Optional[int]
	sentiment: float


def fetch_stock_data(ticker: str) -> StockData:
	try:
		ticker_obj = yf.Ticker(ticker)
		info = ticker_obj.info or {}
		intraday = ticker_obj.history(period='1d', interval='5m')
		history = ticker_obj.history(period='5d', interval='1h')
		return StockData(info=info, intraday=intraday, history=history)
	except Exception as e:
		raise RuntimeError(f"Failed to fetch stock data for {ticker}: {e}")


def fetch_news_data(ticker: str, max_items: int = 20) -> List[NewsItem]:
	# Google News RSS for the ticker symbol
	feed_url = f"https://news.google.com/rss/search?q={ticker}+stock&hl=en-US&gl=US&ceid=US:en"
	d = feedparser.parse(feed_url)
	items: List[NewsItem] = []
	for entry in d.entries[:max_items]:
		title = entry.get('title', '')
		summary = entry.get('summary', '')
		link = entry.get('link', '')
		published = entry.get('published', None)
		score = sia.polarity_scores(f"{title}. {summary}")['compound']
		items.append(NewsItem(title=title, link=link, published=published, summary=summary, sentiment=score))
	return items


def fetch_social_data(query: str, max_items: int = 50) -> List[SocialItem]:
	# Uses snscrape to avoid Twitter API
	cmd = [sys.executable, '-m', 'snscrape', '--jsonl', '--max-results', str(max_items), f'twitter-search "{query} stock"']
	try:
		process = subprocess.run(cmd, capture_output=True, text=True, check=True)
		items: List[SocialItem] = []
		for line in process.stdout.strip().splitlines():
			obj = json.loads(line)
			text = obj.get('content', '')
			created = obj.get('date')
			author = (obj.get('user') or {}).get('displayname')
			likes = obj.get('likeCount')
			replies = obj.get('replyCount')
			retweets = obj.get('retweetCount')
			score = sia.polarity_scores(text)['compound']
			items.append(SocialItem(text=text, created_at=created, author=author, likes=likes, replies=replies, retweets=retweets, sentiment=score))
		return items
	except subprocess.CalledProcessError as e:
		raise RuntimeError(f"snscrape error: {e.stderr}")
